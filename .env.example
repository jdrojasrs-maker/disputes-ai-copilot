# Copia este archivo a .env y ajusta. .env NO se versiona.
DATABASE_URL=postgresql+asyncpg://disputes:disputes@localhost:5432/disputes

# --- LLM client (feature 003) ---
# Placeholders only. Never put a real key in this file; put it in your local .env.
# API key for the Anthropic API. Required to build the Anthropic adapter.
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
# Model identifier sent to the provider. Required; there is no default.
LLM_MODEL=replace-with-a-model-id
# Maximum seconds to wait for each phase of a call (not a total cap). Optional, default 60.
LLM_TIMEOUT_SECONDS=60
